{
    "name": "Auto Repair",
    "description": "Stand still for a few seconds to activate your internal repair system. The speed of your repair is based off how much fuel you have.",
    "type": "origins:multiple",

    "remove-if-wench": {
        "type": "origins:action_over_time",
        "entity_action": {
            "type": "origins:revoke_power",
            "power": "create_automaton:self-repair",
            "source": "create_automaton:automaton"
        },
        "condition": {
            "type": "origins:and",
            "conditions": [
                {
                    "type": "origins:living"
                },
                {
                    "type": "origins:power",
                    "power": "create_automaton:andesite/wrench/no-self-repair",
                    "source": "create_automaton:andesite/wrench"
                }
            ]
        },
        "interval": 1
    },

    "counter": {
        "type": "origins:resource",
        "min": 0,
        "max": 5,
        "start_value": 0,
        "hud_render": {
            "should_render": false
        }
    },

    "counter-reset": {
        "type": "origins:action_over_time",
        "entity_action": {
            "type": "origins:change_resource",
            "resource": "create_automaton:self-repair_counter",
            "operation": "set",
            "change": 0
        },
        "interval": 1,
        "condition": {
            "type": "origins:or",
            "conditions": [
                {
                    "type": "origins:moving"
                },
                {
                    "type": "origins:relative_health",
                    "comparison": "==",
                    "compare_to": 1
                }
            ]
        }
    },

    "counter-increase": {
        "type": "origins:action_over_time",
        "entity_action": {
            "type": "origins:change_resource",
            "resource": "create_automaton:self-repair_counter",
            "change": 1
        },
        "interval": 20,
        "condition": {
            "type": "origins:and",
            "conditions": [
                {
                    "type": "origins:moving",
                    "inverted": true
                },
                {
                    "type": "origins:relative_health",
                    "comparison": "!=",
                    "compare_to": 1
                }
            ]
        }
    },

    "particles": {
        "type": "origins:action_over_time",
        "entity_action": {
            "type": "origins:execute_command",
            "command": "function create_automaton:repair-circle"
        },
        "interval": 2,
        "condition": {
            "type": "origins:and",
            "conditions": [
                {
                    "type": "origins:food_level",
                    "comparison": ">=",
                    "compare_to": 2
                },
                {
                    "type": "origins:resource",
                    "resource": "create_automaton:self-repair_counter",
                    "comparison": "==",
                    "compare_to": 5
                }
            ]
        }
    },

    "heal-max": {
        "type": "origins:action_over_time",
        "entity_action": {
            "type": "origins:heal",
            "amount": 1
        },
        "interval": 20,
        "condition": {
            "type": "origins:and",
            "conditions": [
                {
                    "type": "origins:food_level",
                    "comparison": ">=",
                    "compare_to": 15
                },
                {
                    "type": "origins:resource",
                    "resource": "create_automaton:self-repair_counter",
                    "comparison": "==",
                    "compare_to": 5
                }
            ]
        }
    },
    "heal-medium": {
        "type": "origins:action_over_time",
        "entity_action": {
            "type": "origins:heal",
            "amount": 1
        },
        "interval": 50,
        "condition": {
            "type": "origins:and",
            "conditions": [
                {
                    "type": "origins:food_level",
                    "comparison": ">=",
                    "compare_to": 10
                },
                {
                    "type": "origins:resource",
                    "resource": "create_automaton:self-repair_counter",
                    "comparison": "==",
                    "compare_to": 5
                }
            ]
        }
    },
    "heal-min": {
        "type": "origins:action_over_time",
        "entity_action": {
            "type": "origins:heal",
            "amount": 1
        },
        "interval": 80,
        "condition": {
            "type": "origins:and",
            "conditions": [
                {
                    "type": "origins:food_level",
                    "comparison": ">=",
                    "compare_to": 5
                },
                {
                    "type": "origins:resource",
                    "resource": "create_automaton:self-repair_counter",
                    "comparison": "==",
                    "compare_to": 5
                }
            ]
        }
    }
}