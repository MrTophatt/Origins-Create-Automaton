{
    "name": "Stress-o-Meter",
    "description": "Your parts all take up stress, try not doing too many things in quick succession.",
    "type": "origins:multiple",

    "overstress-toggle": {
        "type": "origins:resource",
        "min": 0,
        "max": 1,
        "start_value": 0,
        "hud_render": {
            "should_render": false
        }
    },

    "stress-meter": {
        "type": "origins:resource",
        "min": 0,
        "max": 1000,
        "start_value": 0,
        "hud_render": {
            "sprite_location": "create_automaton:textures/gui/stress_bars.png",
            "bar_index": 0,
            "condition": {
                "type": "origins:and",
                "conditions": [
                    {
                        "type": "origins:resource",
                        "resource": "create_automaton:stress_overstress-toggle",
                        "comparison": "==",
                        "compare_to": 0
                    },
                    {
                        "type": "origins:resource",
                        "resource": "create_automaton:stress_stress-meter",
                        "comparison": "<",
                        "compare_to": 700
                    },
                    {
                        "type": "origins:power",
                        "power": "create_automaton:extras/stressometer",
                        "inverted": true
                    },
                    {
                        "type": "origins:living"
                    }
                ]
            }
        },
        "min_action": {
            "type": "origins:change_resource",
            "resource": "create_automaton:stress_overstress-toggle",
            "operation": "set",
            "change": 0
        },
        "max_action": {
            "type": "origins:and",
            "actions": [
                {
                    "type": "origins:change_resource",
                    "resource": "create_automaton:stress_overstress-toggle",
                    "operation": "set",
                    "change": 1
                },
                {
                    "type": "origins:execute_command",
                    "command": "execute as @e[type=armor_stand,nbt={Tags:['grapple_hook']},distance=..50.5] if score @s GrappleUUID = @p[distance=0] GrappleUUID run kill @s"
                },
                {
                    "type": "origins:play_sound",
                    "sound": "create:steam",
                    "volume": 1,
                    "pitch": 0.6
                }
            ]
        }
    },
    "warn-stress-meter": {
        "type": "origins:resource",
        "min": 0,
        "max": 1000,
        "start_value": 0,
        "hud_render": {
            "sprite_location": "create_automaton:textures/gui/stress_bars.png",
            "bar_index": 1,
            "condition": {
                "type": "origins:and",
                "conditions": [
                    {
                        "type": "origins:resource",
                        "resource": "create_automaton:stress_overstress-toggle",
                        "comparison": "==",
                        "compare_to": 0
                    },
                    {
                        "type": "origins:resource",
                        "resource": "create_automaton:stress_stress-meter",
                        "comparison": ">=",
                        "compare_to": 700
                    },
                    {
                        "type": "origins:resource",
                        "resource": "create_automaton:stress_stress-meter",
                        "comparison": "!=",
                        "compare_to": 1000
                    },
                    {
                        "type": "origins:power",
                        "power": "create_automaton:extras/stressometer",
                        "inverted": true
                    },
                    {
                        "type": "origins:living"
                    }
                ]
            }
        }
    },
    "overstress-meter": {
        "type": "origins:resource",
        "min": 0,
        "max": 1000,
        "start_value": 0,
        "hud_render": {
            "sprite_location": "create_automaton:textures/gui/stress_bars.png",
            "bar_index": 2,
            "condition": {
                "type": "origins:and",
                "conditions": [
                    {
                        "type": "origins:resource",
                        "resource": "create_automaton:stress_overstress-toggle",
                        "comparison": "==",
                        "compare_to": 1
                    },
                    {
                        "type": "origins:power",
                        "power": "create_automaton:extras/stressometer",
                        "inverted": true
                    },
                    {
                        "type": "origins:living"
                    }
                ]
            }
        }
    },

    "constant-stress": {
        "type": "origins:resource",
        "min": 0,
        "max": 1000,
        "start_value": 0,
        "hud_render": {
            "should_render": false
        }
    },

    "stress": {
        "type": "origins:action_on_callback",
        "entity_action_gained": {
            "type": "origins:and",
            "actions": [
                {
                    "type": "origins:change_resource",
                    "resource": "create_automaton:stress_constant-stress",
                    "change": 0,
                    "operation": "set"
                }
            ]
        },
        "entity_action_added": {
            "type": "origins:execute_command",
            "command": "scoreboard players set @s hp 0"
        },
        "entity_action_lost": {
            "type": "origins:change_resource",
            "resource": "create_automaton:stress_constant-stress",
            "change": 0,
            "operation": "set"
        },
        "entity_action_respawned": {
            "type": "origins:change_resource",
            "resource": "create_automaton:stress_stress-meter",
            "change": 0,
            "operation": "set"
        },
        "execute_chosen_when_orb": true
    },

    "tick": {
        "type": "origins:action_over_time",
        "entity_action": {
            "type": "origins:and",
            "actions": [
                {
                    "type": "origins:if_else",
                    "condition": {
                        "type": "origins:resource",
                        "resource": "create_automaton:stress_overstress-toggle",
                        "comparison": "==",
                        "compare_to": 0
                    },
                    "if_action": {
                        "type": "origins:execute_command",
                        "command": "function create_automaton:damage-taken/tick"
                    }
                },

                {
                    "type": "origins:execute_command",
                    "command": "function create_automaton:store_stress"
                },


                {
                    "type": "origins:modify_resource",
                    "modifier": {
                        "operation": "set_total",
                        "value": 0,
                        "resource": "create_automaton:stress_stress-meter"
                    },
                    "resource": "create_automaton:stress_warn-stress-meter"
                },
                {
                    "type": "origins:modify_resource",
                    "modifier": {
                        "operation": "set_total",
                        "value": 0,
                        "resource": "create_automaton:stress_stress-meter"
                    },
                    "resource": "create_automaton:stress_overstress-meter"
                },

                
                {
                    "type": "origins:if_else",
                    "condition": {
                        "type": "origins:and",
                        "conditions": [
                            {
                                "type": "origins:command",
                                "command": "execute if score @s stress_meter < @s constant_stress",
                                "comparison": "==",
                                "compare_to": 1
                            },
                            {
                                "type": "origins:resource",
                                "resource": "create_automaton:stress_overstress-toggle",
                                "comparison": "==",
                                "compare_to": 0
                            }
                        ]
                    },
                    "if_action": {
                        "type": "origins:modify_resource",
                        "modifier": {
                            "operation": "set_total",
                            "value": 0,
                            "resource": "create_automaton:stress_constant-stress"
                        },
                        "resource": "create_automaton:stress_stress-meter"
                    }
                }
            ]
        },
        "interval": 1,
        "condition": {
            "type": "origins:living"
        }
    },

    "decrease": {
        "type": "origins:action_over_time",
        "entity_action": {
            "type": "origins:if_else",
            "condition": {
                "type": "origins:or",
                "conditions": [
                    {
                        "type": "origins:power_active",
                        "power": "create_automaton:copper/valve/depressure_toggle"
                    },
                    {
                        "type": "origins:and",
                        "conditions": [
                            {
                                "type": "origins:resource",
                                "resource": "create_automaton:stress_stress-meter",
                                "comparison": ">=",
                                "compare_to": 700
                            },
                            {
                                "type": "origins:power",
                                "power": "create_automaton:copper/engine/no-yellow"
                            },
                            {
                                "type": "origins:living"
                            }
                        ]
                    }
                ]
            },
            "if_action": {
                "type": "origins:change_resource",
                "resource": "create_automaton:stress_stress-meter",
                "change": -2
            },
            "else_action": {
                "type": "origins:change_resource",
                "resource": "create_automaton:stress_stress-meter",
                "change": -1
            }
        },
        "interval": 3,
        "condition": {
            "type": "origins:and",
            "conditions": [
                {
                    "type": "origins:command",
                    "command": "execute if score @s stress_meter > @s constant_stress",
                    "comparison": "==",
                    "compare_to": 1
                },
                {
                    "type": "origins:resource",
                    "resource": "create_automaton:stress_overstress-toggle",
                    "comparison": "==",
                    "compare_to": 0
                }
            ]
        }
    },
    "overstress-decrease": {
        "type": "origins:action_over_time",
        "entity_action": {
            "type": "origins:change_resource",
            "resource": "create_automaton:stress_stress-meter",
            "change": -2
        },
        "interval": 7,
        "condition": {
            "type": "origins:and",
            "conditions": [
                {
                    "type": "origins:resource",
                    "resource": "create_automaton:stress_overstress-toggle",
                    "comparison": "==",
                    "compare_to": 1
                },
                {
                    "type": "origins:power",
                    "power": "create_automaton:extras/flywheel",
                    "inverted": true
                }
            ]
        }
    },
    "overstress-decrease-flywheel": {
        "type": "origins:action_over_time",
        "entity_action": {
            "type": "origins:change_resource",
            "resource": "create_automaton:stress_stress-meter",
            "change": -2
        },
        "interval": 5,
        "condition": {
            "type": "origins:and",
            "conditions": [
                {
                    "type": "origins:resource",
                    "resource": "create_automaton:stress_overstress-toggle",
                    "comparison": "==",
                    "compare_to": 1
                },
                {
                    "type": "origins:power",
                    "power": "create_automaton:extras/flywheel"
                }
            ]
        }
    },

    "yellow-and-red-no-run": {
        "type": "origins:prevent_sprinting",
        "condition": {
            "type": "origins:or",
            "conditions": [
                {
                    "type": "origins:resource",
                    "resource": "create_automaton:stress_stress-meter",
                    "comparison": ">=",
                    "compare_to": 700
                },
                {
                    "type": "origins:resource",
                    "resource": "create_automaton:stress_overstress-toggle",
                    "comparison": "==",
                    "compare_to": 1
                }
            ]
        }
    },

    "overstressed-slow": {
        "type": "origins:conditioned_attribute",
        "modifier": {
            "attribute": "minecraft:generic.movement_speed",
            "operation": "multiply_total",
            "value": -0.80
        },
        "tick_rate": 1,
        "condition": {
            "type": "origins:resource",
            "resource": "create_automaton:stress_overstress-toggle",
            "comparison": "==",
            "compare_to": 1
        }
    },

    "stressed-titles": {
        "type": "origins:action_over_time",
        "entity_action": {
            "type": "origins:if_else_list",
            "actions": [
                {
                    "condition": {
                        "type": "origins:resource",
                        "resource": "create_automaton:stress_overstress-toggle",
                        "comparison": "==",
                        "compare_to": 1
                    },
                    "action": {
                        "type": "origins:and",
                        "actions": [
                            {
                                "type": "origins:execute_command",
                                "command": "title @s reset"
                            },
                            {
                                "type": "origins:execute_command",
                                "command": "title @s title {\"text\":\"OVERSTRESSED\",\"color\":\"red\",\"bold\":true,\"italic\":false}"
                            },
                            {
                                "type": "origins:play_sound",
                                "sound": "create:deny",
                                "pitch": 0.8
                            }
                        ]
                    }
                },
                {
                    "condition": {
                        "type": "origins:and",
                        "conditions": [
                            {
                                "type": "origins:resource",
                                "resource": "create_automaton:stress_stress-meter",
                                "comparison": ">=",
                                "compare_to": 700
                            },
                            {
                                "type": "origins:resource",
                                "resource": "create_automaton:stress_overstress-toggle",
                                "comparison": "==",
                                "compare_to": 0
                            }
                        ]
                    },
                    "action": {
                        "type": "origins:and",
                        "actions": [
                            {
                                "type": "origins:execute_command",
                                "command": "title @s title {\"text\":\"\"}"
                            },
                            {
                                "type": "origins:execute_command",
                                "command": "title @s subtitle {\"text\":\"STRESS WARNING\",\"color\":\"gold\",\"bold\":true,\"italic\":false}"
                            },
                            {
                                "type": "origins:play_sound",
                                "sound": "create:deny",
                                "pitch": 1.5
                            }
                        ]
                    }
                }
            ]   
        },
        "interval": 20
    }
}