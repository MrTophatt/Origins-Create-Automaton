{
    "name": "Speed Control",
    "description": "Boost your speed at the cost of tons of stress.",
    "badges": [
        {
            "type": "origins:tooltip",
            "sprite": "origins:textures/gui/badge/star.png",
            "text": "3 Stress/1 Ticks"
        },
        {
            "type": "origins:keybind",
            "sprite": "origins:textures/gui/badge/active.png",
            "text": "Speed up using %s"
        }
    ],
    "type": "origins:multiple",
    
    "stress-increase": {
        "type": "origins:active_self",
        "entity_action": {
            "type": "origins:and",
            "actions": [
                {
                    "type": "origins:change_resource",
                    "resource": "create_automaton:stress_stress-meter",
                    "change": 3
                }
            ]
        },
        "cooldown": 1,
        "key": {
            "key": "key.saveToolbarActivator",
            "continuous": true
        },
        "condition": {
            "type": "origins:and",
            "conditions": [
                {
                    "type": "origins:resource",
                    "resource": "create_automaton:stress_overstress-toggle",
                    "comparison": "==",
                    "compare_to": 0
                },
                {
                    "type": "origins:resource",
                    "resource": "create_automaton:brass/speed-controller/shock_cooldown",
                    "comparison": "==",
                    "compare_to": 0
                }
            ]
        }
    },

    "speed-increase": {
        "type": "origins:conditioned_attribute",
        "modifier": {
            "attribute": "minecraft:generic.movement_speed",
            "value": 0.5,
            "operation": "multiply_total"
        },
        "tick_rate": 1,
        "condition": {
            "type": "origins:and",
            "conditions": [
                {
                    "type": "origins:resource",
                    "resource": "create_automaton:stress_overstress-toggle",
                    "comparison": "==",
                    "compare_to": 0
                },
                {
                    "type": "apugli:key_pressed",
                    "key": {
                        "key": "key.saveToolbarActivator",
                        "continuous": true
                    }
                },
                {
                    "type": "origins:resource",
                    "resource": "create_automaton:brass/speed-controller/shock_cooldown",
                    "comparison": "==",
                    "compare_to": 0
                }
            ]
        }
    }
}