{
    "name": "Heavy Machinery",
    "description": "You are a heavy and bulky machine, movement isn't really your thing. Luckily you can step higher.",
    "type": "origins:multiple",

    "no-jump": {
        "type": "origins:modify_jump",
        "modifier": {
            "operation": "set_total",
            "value": 0
        },
        "condition": {
            "type": "origins:and",
            "conditions": [
                {
                    "type": "origins:resource",
                    "resource": "create_automaton:stress_overstress-toggle",
                    "comparison": "==",
                    "compare_to": 0
                },
                {
                    "type": "sync:key_pressed",
                    "key": {
                        "key": "key.saveToolbarActivator"
                    }
                },
                {
                    "type": "origins:exists"
                },
                {
                    "type": "origins:power",
                    "power": "create_automaton:brass/speed-controller/jump",
                    "source": "create_automaton:brass/speed-controller"
                }
            ],
            "inverted": true
        }
    },

    "step-height": {
        "type": "origins:attribute",
        "modifier": {
            "attribute": "porting_lib:step_height_addition",
            "value": 1.2,
            "operation": "addition"
        }
    },

    "slow": {
        "type": "origins:attribute",
        "modifier": {
            "attribute": "minecraft:generic.movement_speed",
            "value": -0.3,
            "operation": "multiply_total"
        }
    }
}