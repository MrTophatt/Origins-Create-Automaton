{
    "name": "Internal Tanks",
    "description": "Take in lava and water into your internal tanks, holding 4 buckets of each.",
    "badges": [
        {
            "type": "origins:tooltip",
            "sprite": "origins:textures/gui/badge/star.png",
            "text": "Constant 90 Stress"
        },
        {
            "type": "origins:tooltip",
            "sprite": "origins:textures/gui/badge/info.png",
            "text": "Drink water buckets/bottles and lava buckets to fill tanks"
        }
    ],
    "type": "origins:multiple",

    "stress": {
        "type": "origins:action_on_callback",
        "entity_action_gained": {
            "type": "origins:execute_command",
            "command": "tag @s add hasTank"
        },
        "entity_action_lost": {
            "type": "origins:execute_command",
            "command": "tag @s remove hasTank"
        },
        "execute_chosen_when_orb": true
    },

    "water-resource": {
        "type": "origins:resource",
        "min": 0,
        "max": 4000,
        "start_value": 0,
        "hud_render": {
            "sprite_location": "create_automaton:textures/gui/tank_bars.png",
            "bar_index": 0
        }
    },
    "lava-resource": {
        "type": "origins:resource",
        "min": 0,
        "max": 4000,
        "start_value": 0,
        "hud_render": {
            "sprite_location": "create_automaton:textures/gui/tank_bars.png",
            "bar_index": 1
        }
    },

    "water-intake": {
        "type": "sync:edible_item",
        "item_condition": {
            "type": "origins:ingredient",
            "ingredient": {
                "item": "minecraft:water_bucket"
            }
        },
        "food_component": {
            "hunger": 0,
            "saturation": 0,
            "meat": false,
            "always_edible": true
        },
        "consume_animation": "DRINK",
        "consume_sound": "entity.generic.drink",
        "item_action": {
            "type": "origins:consume",
            "amount": 1
        },
        "entity_action": {
            "type": "origins:change_resource",
            "resource": "create_automaton:*_water-resource",
            "change": 1000
        },
        "result_stack": {
            "item": "minecraft:bucket",
            "amount": 1
        }
    },
    "potion-intake": {
        "type": "origins:action_on_item_use",
        "entity_action": {
            "type": "origins:change_resource",
            "resource": "create_automaton:*_water-resource",
            "change": 250
        },
        "item_condition": {
            "type": "origins:ingredient",
            "ingredient": {
                "item": "minecraft:potion"
            }
        }
    },
    "lava-intake": {
        "type": "sync:edible_item",
        "item_condition": {
            "type": "origins:ingredient",
            "ingredient": {
                "item": "minecraft:lava_bucket"
            }
        },
        "food_component": {
            "hunger": 0,
            "saturation": 0,
            "meat": false,
            "always_edible": true
        },
        "consume_animation": "DRINK",
        "consume_sound": "entity.generic.drink",
        "item_action": {
            "type": "origins:consume",
            "amount": 1
        },
        "result_stack": {
            "item": "minecraft:bucket",
            "amount": 1
        },
        "entity_action": {
            "type": "origins:change_resource",
            "resource": "create_automaton:*_lava-resource",
            "change": 1000
        }
    }
}